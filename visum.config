/*
 * ==========================================================
 *  nextflow.config — Template Configuration File
 *  Author: <Your Name>
 *  Project: <Project Name>
 *  Date: <Date>
 * ==========================================================
 */

/*
 * ----------------------------------------------------------
 *                  GENERAL SETTINGS
 * ----------------------------------------------------------
 */
manifest {
    name        = 'my-pipeline'
    author      = '<Your Name>'
    description = 'Template Nextflow pipeline configuration'
    version     = '1.0.0'
}

/*
 * ----------------------------------------------------------
 *                  DEFAULT PARAMETERS
 * ----------------------------------------------------------
 */
params {
    input_dir   = "./data"
    output_dir  = "./results"
    threads     = 8
    memory      = '8 GB'
    email       = null          // optional email for notifications
    resume      = true
}

/*
 * ----------------------------------------------------------
 *                  LOGGING & REPORTING
 * ----------------------------------------------------------
 */
timeline {
    enabled = true
    file    = "${params.output_dir}/reports/timeline.html"
}
report {
    enabled = true
    file    = "${params.output_dir}/reports/report.html"
}
trace {
    enabled = true
    file    = "${params.output_dir}/reports/trace.txt"
}
dag {
    enabled = true
    file    = "${params.output_dir}/reports/dag.png"
}

/*
 * ----------------------------------------------------------
 *                  EXECUTOR SETTINGS
 * ----------------------------------------------------------
 */
process {
    executor = 'local'              // Change to 'slurm' or 'awsbatch' etc.
    cpus     = { params.threads }
    memory   = { params.memory }
    time     = '2h'
    errorStrategy = 'retry'
    maxRetries = 1
    publishDir = [
        path: { "${params.output_dir}/${task.process}" },
        mode: 'copy'
    ]
}

/*
 * ----------------------------------------------------------
 *                  PROFILES
 * ----------------------------------------------------------
 */

profiles {

    // Default local run
    local {
        process.executor = 'local'
        process.cpus     = { params.threads }
        process.memory   = { params.memory }
    }

    // High-Performance Computing (HPC) with SLURM
    slurm {
        process.executor = 'slurm'
        process.queue    = 'standard'
        process.cpus     = { params.threads }
        process.memory   = { params.memory }
        process.time     = '12h'
        process.clusterOptions = '--account=myaccount'
    }

    // Docker containerized run
    docker {
        process.executor = 'local'
        docker.enabled   = true
        docker.runOptions = '-u \$(id -u):\$(id -g)'
        docker.pull      = true
    }

    // Conda environment management
    conda {
        process.conda = 'environment.yml'
        process.executor = 'local'
    }

    // Singularity (for HPC use)
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        process.executor = 'slurm'
    }
}

/*
 * ----------------------------------------------------------
 *                  WORKFLOW BEHAVIOR
 * ----------------------------------------------------------
 */
workDir = "./work"
cleanup = false
executor.queueSize = 100
docker.enabled = false
singularity.enabled = false
