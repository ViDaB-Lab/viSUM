manifest {
  name        = 'viSUM'
  author      = '<Your Name>'
  description = 'viSUM/viCAT Nextflow pipeline'
  version     = '0.1.0'
}

params {
  // SINGLE mode
  input        = null
  prefix       = null
  type         = null   // dna|rna

  // MULTI mode
  indir        = null
  prefix_many  = null   // CSV: prefix,type,fasta

  // Resource controls. max_cpus/max_memory are the total budget available to
  // the local Nextflow executor; *_cpus/*_memory below are per-task requests.
  // Keep the legacy parameter declared only so the workflow can reject it
  // with a useful migration message instead of silently ignoring --threads.
  max_cpus      = 8
  max_memory    = '48 GB'
  utility_memory = '2 GB'
  utility_time   = '2h'
  threads       = null
  vicat_build_threads = null
  vicat_orf_threads = null
  vicat_threads = null

  // output
  outdir       = 'results'
  dbdir        = "${projectDir}/databases" // persistent viSUM-managed databases
  tooldir      = "${projectDir}/tools"     // persistent viSUM-managed software/model bundles

  // geNomad
  run_genomad             = true
  genomad_db              = null  // optional user-supplied database directory
  genomad_auto_download   = true
  genomad_version         = '1.12.0'
  genomad_cpus            = 4
  genomad_memory          = '16 GB'
  genomad_time            = '12h'
  genomad_splits          = 0     // fastest; increase to reduce memory usage
  genomad_cleanup         = true

  // Params you probably don't need to touch, but could if you wanted.

  // ictv masters species list
  ictv_csv     = "${projectDir}/assets/ICTV_masterspecieslist_5_11_25.csv" // update as you see fit by downloading new versions

  // Deep6 runs automatically for RNA/metatranscriptomic inputs only. Set
  // --run_deep6 false to skip it explicitly.
  run_deep6           = true
  deep6_dir           = null // optional user-supplied Deep6 repository directory
  deep6_model         = null // optional user-supplied directory containing all four models
  deep6_auto_download = true
  deep6_repository    = 'https://github.com/janfelix/Deep6.git'
  // Deep6 has no tagged releases, so viSUM pins the tested source revision.
  deep6_revision      = '8edf0d75a62469c1db6c0b8c5bf5c8c434f0381f'
  deep6_minlen        = 250
  deep6_min_score     = 0.7
  deep6_median_multiplier = 1.25
  deep6_cpus          = 1
  deep6_memory        = '4 GB'
  deep6_time          = '24h'

  // DeepMicroClass2 runs automatically for DNA/metagenomic inputs only. Set
  // --run_deepmicroclass2 false to skip it explicitly. The repository bundles
  // its trained model checkpoints, so no separate database is needed.
  run_deepmicroclass2           = true
  deepmicroclass2_dir           = null // optional user-supplied repository directory
  deepmicroclass2_auto_download = true
  deepmicroclass2_repository    = 'https://github.com/aiguo-11/DeepMicroClass2.git'
  // DeepMicroClass2 has no releases; viSUM pins the inspected source revision.
  deepmicroclass2_revision      = '9622bd6ca14d8b844c574e06d1ffc020d1052ca8'
  // Model choices:
  //   8class        (default/fastest): uses non-overlapping, length-matched
  //                 500-, 1000-, and 3000-nt models; sequences <500 nt are
  //                 not predicted.
  //   high_precision: uses overlapping windows with the same length-matched
  //                 models and adds the 300-nt model for 300-499 nt contigs;
  //                 this retains more sequence context but takes longer.
  //   300bp         (advanced): applies only the 300-nt model to every contig
  //                 >=300 nt, including long contigs. This sacrifices longer
  //                 context and should be used only for a deliberate
  //                 short-window comparison.
  deepmicroclass2_model         = '8class'
  deepmicroclass2_cpus          = 4
  deepmicroclass2_memory        = '8 GB'
  deepmicroclass2_time          = '6h'

  // virsorter2 params
  run_virsorter2            = true
  virsorter2_db             = null // optional user-supplied database directory
  virsorter2_auto_download  = true
  virsorter2_version        = '2.2.4'
  virsorter2_cpus           = 4
  virsorter2_memory         = '16 GB'
  virsorter2_time           = '12h'
  vs2_min_length = 1500 // minimum sequence length
  vs2_min_score  = 0.5  // minimum virus score to keep classification
  // DNA inputs use DNA-virus models. RNA/metatranscriptomic inputs use both
  // DNA- and RNA-virus models because either kind of virus may be represented.
  vs2_groups_dna = "dsDNAphage,ssDNA,NCLDV,lavidaviridae"
  vs2_groups_rna = "dsDNAphage,ssDNA,NCLDV,lavidaviridae,RNA"


  // --- Cenote-Taker3 ---
  run_cenotetaker3    = true
  ct3_db               = null // optional user-supplied database directory
  ct3_auto_download    = true
  ct3_version          = '3.4.4'
  ct3_cpus             = 4
  ct3_memory           = '16 GB'
  ct3_hmm_db_version   = 'v3.1.1'
  ct3_time             = '12h'
  // HHsuite databases are optional and very large. The initial viSUM mode
  // uses -hh none, so automatic setup installs only CT3's required core data.
  ct3_prune_prophage_dna = 'T'
  ct3_prune_prophage_rna = 'F'
  ct3_caller          = 'prodigal-gv'
  ct3_hh              = 'none'
  ct3_taxdb           = 'hallmark'
  // Search all hallmark classes for both input types. This preserves RNA-virus,
  // DNA-virus, and potential proviral evidence for later harmonization.
  ct3_domaindb        = 'virion rdrp dnarep'
  ct3_minlen_circ     = 1000
  ct3_circ_minhall    = 1
  ct3_minlen_linear   = 1000
  ct3_linear_minhall  = 1
  ct3_wrap            = 'F'
  ct3_genbank         = 'F'

  // VITAP 
  vitap_vmr_csv   = "${projectDir}/assets/msl40_3_1_26.csv" // can change and specify updated file in the future
  vitap_db_label  = "VMR-MSL40"                       // name for DB folder DB_<label>
  vitap_dir       = "${params.dbdir}/vitap"           // tool-specific DB root under global dbdir

  // viCAT is optional until redistribution of the prebuilt MetaVR-derived
  // database is confirmed. It supports both DNA and RNA inputs.
  run_vicat = false
  // Use an existing prebuilt database without rebuilding. The current
  // development build layout and the final flat runtime layout are accepted.
  vicat_db = null
  // For a local one-time build, download both original MetaVR5 files and set
  // their paths. User-owned source downloads are validated but never deleted.
  // Building requires substantial temporary disk space and approximately
  // 300 GB RAM during the vOTU-balanced taxonomy aggregation stage.
  vicat_metavr_proteins = null // IMGVR5_UViG.faa.gz
  vicat_metavr_metadata = null // IMGVR5_UViG.tsv.gz
  vicat_managed_db = "${params.dbdir}/vicat/metavr5"
  // Checksums and record counts pin the exact MetaVR5 inputs tested by viSUM.
  vicat_metavr_proteins_sha256 = 'e3a7b7826db5562b5a16c38f3033c0fa35a9b2d4a48ed25a4c37e516db471aa4'
  vicat_metavr_metadata_sha256 = 'df07af7f9364374d3726f75421d4ad29262a8cbdf97ad05237af2b01fc8a8a3d'
  vicat_expected_uvigs = 24435662
  vicat_expected_proteins = 369319989
  vicat_expected_representatives = 178734704
  vicat_build_cpus = 32
  vicat_build_memory = '350 GB'
  vicat_build_time = '12h'
  // viCAT analysis: DNA inputs use pyrodigal-gv; RNA/metatranscriptomic
  // inputs combine pyrodigal-gv and pyrodigal-rv predictions.
  vicat_orf_cpus = 4
  vicat_orf_memory = '8 GB'
  vicat_orf_time = '4h'
  vicat_cpus = 8
  vicat_memory = '32 GB'
  vicat_time = '12h'
  // User-adjustable DIAMOND settings. Each can also be overridden on the
  // command line, for example: --vicat_min_query_cover 40.
  // Choices: faster, fast, mid-sensitive, sensitive, more-sensitive,
  // very-sensitive, or ultra-sensitive.
  vicat_diamond_sensitivity = 'sensitive'
  // Minimum DIAMOND bit score retained.
  vicat_min_bitscore = 50
  // Minimum percentage of the query protein covered by the alignment.
  vicat_min_query_cover = 30
  // Retain alignments within 5% of an ORF's best bitscore.
  vicat_top_percent = 5
  // Reference letters processed per block, in billions. Larger values use
  // roughly 6 x this value in GB of RAM and may improve performance.
  vicat_block_size = 2.0
  // Seed-index chunks. A value of 1 is fastest but uses more memory.
  vicat_index_chunks = 4
  // Alternative GV/RV predictions with at least 80% reciprocal nucleotide
  // overlap (or the same stop) are treated as one genomic locus.
  vicat_locus_overlap = 0.80
  // Minimum relative-bitscore-weighted support among eligible reference
  // lineages required to assign each rank to an individual ORF.
  vicat_orf_taxonomy_support = 0.60
  // Minimum fraction of eligible ORF loci supporting the winning taxon at
  // each contig-level rank. Conflict-truncated/unclassified loci abstain.
  // These thresholds affect taxonomy only, not viral-homology evidence.
  vicat_contig_taxonomy_support = 0.60
  vicat_standardizer_memory = '16 GB'
  vicat_standardizer_time = '4h'
  
  // GiantHunter runs automatically for DNA/metagenomic inputs only. Set
  // --run_gianthunter false to skip it explicitly. It identifies NCLDV-like
  // contigs and is not run on RNA/metatranscriptomic inputs.
  run_gianthunter            = true
  gianthunter_db             = null // optional user-supplied gianthunter_db_v1 directory
  gianthunter_auto_download  = true
  // GiantHunter 1.1.0 is pinned to its exact release commit in
  // envs/gianthunter.yml. Its official database is attached to release v2.0.
  gianthunter_database_release = 'v2.0'
  gianthunter_database_url   = 'https://github.com/FuchuanQu/GiantHunter/releases/download/v2.0/gianthunter_db_v1.zip'
  gianthunter_database_sha256 = '499e8efa89c9f6c0ffab1692b94c590f32b34c5aae1eaf44c36d7f22074e1c63'
  gianthunter_cpus           = 4
  // Official defaults from the pinned 1.1.0 implementation. Contigs shorter
  // than 3 kb are not scored; reject is the minimum aligned-protein fraction.
  gianthunter_min_length     = 3000
  gianthunter_reject         = 0.1
  gianthunter_query_cover    = 40
  gianthunter_memory         = '16 GB'
  gianthunter_time           = '12h'

  // VirBot runs automatically for RNA/metatranscriptomic inputs only. Set
  // --run_virbot false to skip it explicitly. VirBot bundles its RNA-virus
  // pHMM and DIAMOND references with the installation through Git LFS.
  run_virbot             = true
  virbot_dir             = null // optional complete VirBot repository with extracted virbot/data/ref
  virbot_auto_download   = true
  virbot_repository      = 'https://github.com/GreyGuoweiChen/VirBot.git'
  // VirBot has no tagged releases, so viSUM pins the inspected source revision.
  virbot_revision        = 'c9680de588dca8f9280d107259b51e45192ef669'
  virbot_cpus            = 4
  // false uses the official HMM-only default and is faster. true adds a
  // DIAMOND search for additional sensitivity at increased runtime.
  virbot_sensitive       = false
  // TOP (official default) uses the highest-scoring positive protein. LCA
  // reports the common lineage supported by positive proteins.
  virbot_taxa            = 'TOP'
  virbot_memory          = '8 GB'
  virbot_time            = '12h'

  // VCONTACT3
  vcontact3_dir = "${params.dbdir}/vcontact3/"
  
}

timeline {
  enabled = true
  file    = "${params.outdir}/reports/timeline.html"
  overwrite = true
}
report {
  enabled = true
  file    = "${params.outdir}/reports/report.html"
  overwrite = true
}
trace {
  enabled = true
  file    = "${params.outdir}/reports/trace.txt"
  overwrite = true
}
dag {
  enabled = true
  file    = "${params.outdir}/reports/dag.png"
  overwrite = true
}

process {
  executor      = 'local'
  // Utility processes inherit these conservative defaults. Compute-heavy
  // modules override them with their own tool-specific parameters.
  cpus          = 1
  memory        = { params.utility_memory }
  time          = { params.utility_time }
  errorStrategy = 'retry'
  maxRetries    = 1
}

profiles {

  local {
    process.executor = 'local'
  }

  // Explicit shared-server preset. Command-line --max_cpus/--max_memory
  // values can still override this profile when a different budget is known.
  local_safe {
    process.executor = 'local'
    params.max_cpus = 8
    params.max_memory = '48 GB'
  }

  // Dedicated workstation/server preset. Per-tool requests remain unchanged;
  // this profile permits more independent tasks to run concurrently.
  local_full {
    process.executor = 'local'
    params.max_cpus = 32
    params.max_memory = '128 GB'
  }

  // viCAT database construction is intentionally separate from ordinary
  // analysis because its taxonomy aggregation requires about 350 GB RAM.
  vicat_build {
    process.executor = 'local'
    params.max_cpus = 32
    params.max_memory = '400 GB'
  }

  slurm {
    process.executor = 'slurm'
    process.queue    = 'standard'
    process.time     = '12h'
    // process.clusterOptions = '--account=myaccount'  // optional
  }

  docker {
    docker.enabled    = true
    docker.pull       = true
    docker.runOptions = '-u $(id -u):$(id -g)'
  }

  singularity {
    singularity.enabled   = true
    singularity.autoMounts = true
  }
}

// Conda settings (GLOBAL)
conda.enabled  = true
conda.useMamba = true
conda.cacheDir = "${projectDir}/.conda"

workDir            = "./work"
cleanup            = false
executor.queueSize = 100
// Unlike process.cpus, these are workflow-wide scheduling ceilings for the
// local executor. The direct executor settings are compatible with the
// stable Nextflow release used to test viSUM (26.04.x).
executor.cpus = params.max_cpus
executor.memory = params.max_memory
