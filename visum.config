manifest {
  name        = 'viSUM'
  author      = '<Your Name>'
  description = 'viSUM/viCAT Nextflow pipeline'
  version     = '0.1.0'
}

params {
  // SINGLE mode
  input        = null
  prefix       = null
  type         = null   // dna|rna

  // MULTI mode
  indir        = null
  prefix_many  = null   // CSV: prefix,type,fasta

  // resources
  threads      = 8
  memory       = '8 GB'
  time         = '2h'

  // output
  outdir       = 'results'
  dbdir        = "${projectDir}/databases" // persistent viSUM-managed databases
  tooldir      = "${projectDir}/tools"     // persistent viSUM-managed software/model bundles

  // geNomad
  run_genomad             = true
  genomad_db              = null  // optional user-supplied database directory
  genomad_auto_download   = true
  genomad_version         = '1.12.0'
  genomad_splits          = 0     // fastest; increase to reduce memory usage
  genomad_cleanup         = true

  // Params you probably don't need to touch, but could if you wanted.

  // ictv masters species list
  ictv_csv     = "${projectDir}/assets/ICTV_masterspecieslist_5_11_25.csv" // update as you see fit by downloading new versions

  // Deep6: runs only for RNA/metatranscriptomic inputs.
  run_deep6           = false
  deep6_dir           = null // optional user-supplied Deep6 repository directory
  deep6_model         = null // optional user-supplied directory containing all four models
  deep6_auto_download = true
  deep6_repository    = 'https://github.com/janfelix/Deep6.git'
  // Deep6 has no tagged releases, so viSUM pins the tested source revision.
  deep6_revision      = '8edf0d75a62469c1db6c0b8c5bf5c8c434f0381f'
  deep6_minlen        = 250
  deep6_min_score     = 0.7
  deep6_median_multiplier = 1.25
  deep6_memory        = '4 GB'
  deep6_time          = '24h'

  // DeepMicroClass2: runs only for DNA/metagenomic inputs. The repository
  // bundles its trained model checkpoints, so no separate database is needed.
  run_deepmicroclass2           = false
  deepmicroclass2_dir           = null // optional user-supplied repository directory
  deepmicroclass2_auto_download = true
  deepmicroclass2_repository    = 'https://github.com/aiguo-11/DeepMicroClass2.git'
  // DeepMicroClass2 has no releases; viSUM pins the inspected source revision.
  deepmicroclass2_revision      = '9622bd6ca14d8b844c574e06d1ffc020d1052ca8'
  // Model choices:
  //   8class        (default/fastest): uses non-overlapping, length-matched
  //                 500-, 1000-, and 3000-nt models; sequences <500 nt are
  //                 not predicted.
  //   high_precision: uses overlapping windows with the same length-matched
  //                 models and adds the 300-nt model for 300-499 nt contigs;
  //                 this retains more sequence context but takes longer.
  //   300bp         (advanced): applies only the 300-nt model to every contig
  //                 >=300 nt, including long contigs. This sacrifices longer
  //                 context and should be used only for a deliberate
  //                 short-window comparison.
  deepmicroclass2_model         = '8class'
  deepmicroclass2_memory        = '8 GB'
  deepmicroclass2_time          = '6h'

  // virsorter2 params
  run_virsorter2            = true
  virsorter2_db             = null // optional user-supplied database directory
  virsorter2_auto_download  = true
  virsorter2_version        = '2.2.4'
  vs2_min_length = 1500 // minimum sequence length
  vs2_min_score  = 0.5  // minimum virus score to keep classification
  // DNA inputs use DNA-virus models. RNA/metatranscriptomic inputs use both
  // DNA- and RNA-virus models because either kind of virus may be represented.
  vs2_groups_dna = "dsDNAphage,ssDNA,NCLDV,lavidaviridae"
  vs2_groups_rna = "dsDNAphage,ssDNA,NCLDV,lavidaviridae,RNA"


  // --- Cenote-Taker3 ---
  run_cenotetaker3    = true
  ct3_db               = null // optional user-supplied database directory
  ct3_auto_download    = true
  ct3_version          = '3.4.4'
  ct3_hmm_db_version   = 'v3.1.1'
  ct3_time             = '12h'
  // HHsuite databases are optional and very large. The initial viSUM mode
  // uses -hh none, so automatic setup installs only CT3's required core data.
  ct3_prune_prophage_dna = 'T'
  ct3_prune_prophage_rna = 'F'
  ct3_caller          = 'prodigal-gv'
  ct3_hh              = 'none'
  ct3_taxdb           = 'hallmark'
  // Search all hallmark classes for both input types. This preserves RNA-virus,
  // DNA-virus, and potential proviral evidence for later harmonization.
  ct3_domaindb        = 'virion rdrp dnarep'
  ct3_minlen_circ     = 1000
  ct3_circ_minhall    = 1
  ct3_minlen_linear   = 1000
  ct3_linear_minhall  = 1
  ct3_wrap            = 'F'
  ct3_genbank         = 'F'

  // VITAP 
  vitap_vmr_csv   = "${projectDir}/assets/msl40_3_1_26.csv" // can change and specify updated file in the future
  vitap_db_label  = "VMR-MSL40"                       // name for DB folder DB_<label>
  vitap_dir       = "${params.dbdir}/vitap"           // tool-specific DB root under global dbdir

  // VICAT
  vicat_dir       = "${params.dbdir}/vicat"   // tool-specific DB root under global dbdir
  
  // GiantHunter
  gianthunter_dir   = "${params.dbdir}/gianthunter"

  // VirBot
  virbot_repo_dir = "${params.dbdir}/virbot/repo" //clone VirBot git repo (https://github.com/GreyGuoweiChen/VirBot/tree/main) to this location or set path to specific location on machine
  virbot_db_dir  = "${params.dbdir}/virbot/ref" // Download and place VirBot DB the viSUM datbase directory OR any place, just provide the accurate path

  // VCONTACT3
  vcontact3_dir = "${params.dbdir}/vcontact3/"
  
}

timeline {
  enabled = true
  file    = "${params.outdir}/reports/timeline.html"
}
report {
  enabled = true
  file    = "${params.outdir}/reports/report.html"
}
trace {
  enabled = true
  file    = "${params.outdir}/reports/trace.txt"
}
dag {
  enabled = true
  file    = "${params.outdir}/reports/dag.png"
}

process {
  executor      = 'local'
  cpus          = { params.threads }
  memory        = { params.memory }
  time          = { params.time }
  errorStrategy = 'retry'
  maxRetries    = 1
}

profiles {

  local {
    process.executor = 'local'
  }

  slurm {
    process.executor = 'slurm'
    process.queue    = 'standard'
    process.time     = '12h'
    // process.clusterOptions = '--account=myaccount'  // optional
  }

  docker {
    docker.enabled    = true
    docker.pull       = true
    docker.runOptions = '-u $(id -u):$(id -g)'
  }

  singularity {
    singularity.enabled   = true
    singularity.autoMounts = true
  }
}

// Conda settings (GLOBAL)
conda.enabled  = true
conda.useMamba = true
conda.cacheDir = "${projectDir}/.conda"

workDir            = "./work"
cleanup            = false
executor.queueSize = 100
